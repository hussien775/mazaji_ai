# ========================================================
# Mazaji AI - Environment Configuration Example
# قم بنسخ هذا الملف إلى .env وتعبئة القيم الخاصة ببيئتك
# ========================================================

# معلومات المشروع
PROJECT_NAME="Mazaji AI"
API_V1_STR="/api/v1"
DEBUG=False

# مفتاح أمان واجهات برمجة التطبيقات (API Key)
API_SECRET_KEY="mazaji_ai_secure_prod_key_9f82d1c4b7e"

# بيانات الاتصال بقاعدة البيانات
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="mazaji_user"
DB_PASSWORD="your_strong_password_here"
DB_NAME="mazaji_db"

# مسبح اتصالات قاعدة البيانات
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# أمان الطلبات المفرطة ومشاركة الموارد
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=["*"]

# قاعدة بيانات المتجهات (كيو-درانت)
QDRANT_PATH="./qdrant_storage"
QDRANT_URL=""
QDRANT_API_KEY=""

# خادم الذاكرة السريعة والجلسات (ريديس)
REDIS_URL=""
SESSION_TTL_SECONDS=86400
MAX_SESSION_HISTORY=10

# روابط وسائط الصور
MEDIA_BASE_URL="https://booking.najaz.in/storage"

# نماذج الذكاء الاصطناعي وجوجل جيميني
GEMINI_API_KEY="your_google_gemini_api_key_here"
EMBEDDING_MODEL="gemini-embedding-001"
CHAT_MODEL="gemini-3.5-flash"
